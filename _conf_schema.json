{
  "plite_render": {
    "description": "启用渲染长图卡片（关闭后直接发送文本/媒体）",
    "type": "bool",
    "default": true
  },
  "plite_video_file_threshold_mb": {
    "description": "视频改用文件消息发送的大小阈值（MB）",
    "type": "int",
    "default": 100
  },
  "plite_verbose_error": {
    "description": "解析失败时向会话发送简短错误说明（默认仅回应表情并记日志）",
    "type": "bool",
    "default": false
  },
  "plite_zhihu_ck": {
    "description": "知乎 cookies",
    "type": "string",
    "default": ""
  },
  "plite_linuxdo_ck": {
    "description": "linuxdo cookies",
    "type": "string",
    "default": ""
  },
  "plite_need_upload": {
    "description": "是否需要上传音视频文件（兼容旧配置）",
    "type": "bool",
    "default": false
  },
  "plite_need_upload_audio": {
    "description": "是否需要上传音频文件",
    "type": "bool",
    "default": false
  },
  "plite_need_upload_video": {
    "description": "是否需要上传视频文件",
    "type": "bool",
    "default": false
  },
  "plite_use_base64": {
    "description": "是否使用 base64 编码发送图片，音频，视频",
    "type": "bool",
    "default": false
  },
  "plite_max_size": {
    "description": "资源最大大小，默认 90 单位 MB",
    "type": "int",
    "default": 90
  },
  "plite_append_url": {
    "description": "是否在解析结果中添加原始URL",
    "type": "bool",
    "default": false
  },
  "plite_embed_url": {
    "description": "是否在解析结果中添加嵌入式播放链接",
    "type": "bool",
    "default": false
  },
  "plite_append_qrcode": {
    "description": "是否在解析结果中添加原始URL二维码",
    "type": "bool",
    "default": false
  },
  "plite_disabled_platforms": {
    "description": "禁用的解析器",
    "type": "list",
    "default": [],
    "options": [
      "acfun",
      "bilibili",
      "douyin",
      "kuaishou",
      "kugou",
      "netease",
      "x",
      "weibo",
      "rednote",
      "qsmusic",
      "kuwo",
      "tieba",
      "zhihu",
      "duitang",
      "heybox",
      "lofter",
      "buff",
      "coolapk",
      "illu",
      "hupu",
      "miyoushe",
      "douban",
      "5eplay",
      "doubao",
      "linuxdo",
      "wmpvp",
      "zlb",
      "taptap",
      "ds"
    ]
  },
  "plite_blacklist_users": {
    "description": "黑名单用户列表，这些用户触发的解析将被忽略",
    "type": "list",
    "default": []
  },
  "plite_bili_video_codes": {
    "description": "B站视频编码",
    "type": "list",
    "default": [
      "avc",
      "av01",
      "hev",
      "unknown"
    ],
    "options": [
      "hev",
      "avc",
      "av01",
      "unknown"
    ]
  },
  "plite_bili_video_quality": {
    "description": "B站视频清晰度",
    "type": "int",
    "default": 80,
    "options": [
      5,
      6,
      16,
      32,
      64,
      74,
      80,
      100,
      112,
      116,
      120,
      125,
      126,
      127
    ]
  },
  "plite_need_forward_contents": {
    "description": "是否需要合并转发内容(大于四项时始终转发)",
    "type": "bool",
    "default": true
  },
  "plite_lazy_download": {
    "description": "是否开启懒下载模式，仅在用户请求时才下载视频",
    "type": "bool",
    "default": false
  },
  "plite_lazy_download_tip": {
    "description": "懒下载是否发送命令提示",
    "type": "bool",
    "default": false
  },
  "plite_lazy_download_timeout": {
    "description": "懒下载模式等待命令超时时间",
    "type": "int",
    "default": 30
  },
  "plite_download_command": {
    "description": "在懒下载模式中用户请求下载视频时的命令列表",
    "type": "list",
    "default": [
      "xz",
      "下载"
    ]
  },
  "plite_live_photo": {
    "description": "是否使用 ffmpeg 转码 Live Photo",
    "type": "bool",
    "default": true
  },
  "plite_max_comments": {
    "description": "最大评论数量",
    "type": "int",
    "default": 5
  },
  "plite_forward_text_threshold": {
    "description": "纯文本文本长度阈值，超过此长度的文本将会强制转发(最大4500)",
    "type": "int",
    "default": 1000
  },
  "plite_max_retries": {
    "description": "最大下载重试次数",
    "type": "int",
    "default": 3
  },
  "plite_day_range": {
    "description": "白天时间范围 [开始, 结束]，格式 h:m；范围内为浅色主题，范围外为夜间模式",
    "type": "list",
    "default": [
      "6:00",
      "19:00"
    ]
  },
  "plite_bili_cdn_region": {
    "description": "哔哩哔哩 CDN 地区；支持 zh、en、ja、proxy 线路",
    "type": "string",
    "default": "zh",
    "options": [
      "zh",
      "en",
      "ja",
      "proxy"
    ]
  },
  "plite_bili_cdn_domain": {
    "description": "自定义哔哩哔哩 CDN 域名，优先于地区配置",
    "type": "string",
    "default": ""
  }
}
